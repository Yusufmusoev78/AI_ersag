ANTHROPIC_API_KEY=sk-ant-...
# For testing with Google Gemini instead of Claude, set this and leave ANTHROPIC_API_KEY unset:
GEMINI_API_KEY=...
# For OpenCode Zen's free models (https://opencode.ai/auth) instead of Claude/Gemini:
OPENCODE_API_KEY=...

# Optional: enables the "Continue with Google" button on the sign-in screen.
# Create an OAuth 2.0 Client ID (Web application) at https://console.cloud.google.com/apis/credentials
# and add the redirect URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/auth/google/callback
